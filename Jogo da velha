import tkinter as tk
from tkinter import messagebox

class JogoDaVelha:
    def __init__(self):
        self.janela = tk.Tk()
        self.janela.title("Jogo da Velha")
        self.janela.geometry("300x300")

        self.turno = "X"
        self.tabuleiro = [""] * 9

        self.botoes = []
        for i in range(9):
            botao = tk.Button(self.janela, text="", command=lambda i=i: self.fazer_jogada(i))
            botao.grid(row=i // 3, column=i % 3)
            self.botoes.append(botao)

    def fazer_jogada(self, posicao):
        if self.tabuleiro[posicao] == "":
            self.tabuleiro[posicao] = self.turno
            self.botoes[posicao].config(text=self.turno)
            if self.verificar_vitoria():
                messagebox.showinfo("Fim do Jogo", f"Jogador {self.turno} venceu!")
                self.janela.quit()
            elif "" not in self.tabuleiro:
                messagebox.showinfo("Fim do Jogo", "Empate!")
                self.janela.quit()
            else:
                self.turno = "O" if self.turno == "X" else "X"

    def verificar_vitoria(self):
        linhas = [(0, 1, 2), (3, 4, 5), (6, 7, 8),
                  (0, 3, 6), (1, 4, 7), (2, 5, 8),
                  (0, 4, 8), (2, 4, 6)]
        for linha in linhas:
            if self.tabuleiro[linha[0]] == self.tabuleiro[linha[1]] == self.tabuleiro[linha[2]] != "":
                return True
        return False

